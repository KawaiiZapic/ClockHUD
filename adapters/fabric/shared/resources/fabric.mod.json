{
  "schemaVersion": 1,
  "id": "clock-hud-adapter",
  "version": "${version}",
  "name": "Clock HUD Adapter (${minecraft})",
  "license": "WTFPL",
  "environment": "client",
  "entrypoints": {
    "clock-hud:platform": [
      "moe.zapic.clockhud.platform.MinecraftPlatform"
    ]
  },
  "mixins": [
    "clock-hud-adapter.mixins.json"
  ],
  "custom": {
    "modmenu": {
      "parent": "clock-hud",
      "badges": [
        "library"
      ]
    }
  },
  "depends": {
    "clock-hud": "=${version}",
    "minecraft": "${minecraft_range}",
    "java": ">=${java}",
    "fabricloader": ">=${loader_version}",
    "fabric-lifecycle-events-v1": "*",
    "fabric-key-binding-api-v1": "*",
    "fabric-resource-loader-${fabric_resource_loader}": "*",
    "${cloth_mod_id}": "*"
  }
}
