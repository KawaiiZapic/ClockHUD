{
  "schemaVersion": 1,
  "id": "clock-hud-adapter",
  "version": "${version}",
  "name": "Clock HUD Adapter (1.19.4)",
  "license": "WTFPL",
  "environment": "client",
  "entrypoints": {
    "clock-hud:platform": [
      "moe.zapic.clockhud.platform.MinecraftPlatform"
    ]
  },
  "mixins": [
    "clock-hud-adapter.mixins.json"
  ],
  "custom": {
    "modmenu": {
      "parent": "clock-hud",
      "badges": [
        "library"
      ]
    }
  },
  "depends": {
    "clock-hud": "=${version}",
    "minecraft": ">=1.19.4 <1.20",
    "java": ">=17",
    "fabricloader": ">=${loader_version}",
    "fabric-lifecycle-events-v1": "*",
    "fabric-key-binding-api-v1": "*",
    "fabric-resource-loader-v0": "*",
    "cloth-config": "*"
  }
}
