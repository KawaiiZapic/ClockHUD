{
  "schemaVersion": 1,
  "id": "clock-hud",
  "version": "${version}",

  "name": "Clock HUD",
  "description": "Display a clock in game",
  "authors": [
    "KawaiiZapic"
  ],
  "contact": {
    "homepage": "https://i.zapic.moe/",
    "sources": "https://github.com/KawaiiZapic/ClockHUD"
  },

  "license": "WTFPL",
  "icon": "assets/clock-hud/icon.png",

  "environment": "client",
  "entrypoints": {
    "client": [
      "moe.zapic.clockhud.Main"
    ],
    "modmenu": [
      "moe.zapic.clockhud.config.ModMenuImpl"
    ]
  },
  "mixins": [
    "clock-hud.mixins.json"
  ],

  "depends": {
    "minecraft": ">=1.21.11",
    "java": ">=21",
    "fabricloader": "*",
    "fabric-api": "*",
    "cloth-config": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
